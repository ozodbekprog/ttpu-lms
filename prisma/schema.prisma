generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum MaterialType {
  TEXT
  FILE
  VIDEO
  LINK
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  LATE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TEXT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  coverUrl     String?
  bio          String?
  preferences  Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  taughtCourses Course[]       @relation("CourseTeacher")
  enrollments   Enrollment[]
  submissions   Submission[]
  attendance    Attendance[]
  quizAttempts  QuizAttempt[]
  notifications Notification[]

  announcements        Announcement[]
  forumTopics          ForumTopic[]
  forumReplies         ForumReply[]
  certificatesIssued   Certificate[]      @relation("CertificateIssuedBy")
  certificatesReceived Certificate[]      @relation("CertificateStudent")
  attendanceSessions   AttendanceSession[]
  conversationsA       Conversation[]     @relation("ConversationA")
  conversationsB       Conversation[]     @relation("ConversationB")
  messagesSent         Message[]          @relation("MessageSender")
  roomBookings         RoomBooking[]
  orders               Order[]
  courseReviews        CourseReview[]
  subjectsTaught       TeacherSubject[]
  scheduleEntriesTaught ScheduleEntry[]   @relation("ScheduleTeacher")

  @@index([groupId])
}

model Group {
  id       String          @id @default(cuid())
  name     String          @unique
  year     Int?
  users    User[]
  schedule ScheduleEntry[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverColor  String   @default("#2563eb")
  isPublished Boolean  @default(false)
  isElective  Boolean  @default(false)
  subjectId   String?
  createdAt   DateTime @default(now())

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  teacherId String
  teacher   User   @relation("CourseTeacher", fields: [teacherId], references: [id])

  sections    Section[]
  assignments Assignment[]
  quizzes     Quiz[]
  enrollments Enrollment[]
  attendance  Attendance[]

  announcements      Announcement[]
  forumTopics        ForumTopic[]
  certificates       Certificate[]
  attendanceSessions AttendanceSession[]
  reviews            CourseReview[]

  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model Section {
  id       String @id @default(cuid())
  courseId String
  title    String
  position Int    @default(0)

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[]
}

model Material {
  id        String       @id @default(cuid())
  sectionId String
  title     String
  type      MaterialType @default(TEXT)
  content   String?
  fileUrl   String?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  description String?
  dueAt       DateTime?
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  text         String?
  fileUrl      String?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  courseId  String
  studentId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  note      String?

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
}

model Quiz {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  description  String?
  dueAt        DateTime?
  timeLimitMin Int?
  maxAttempts  Int      @default(1)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id       String       @id @default(cuid())
  quizId   String
  text     String
  type     QuestionType @default(SINGLE)
  options  Json         @default("[]")
  correct  Json         @default("[]")
  points   Int          @default(1)
  position Int          @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id         String    @id @default(cuid())
  quizId     String
  studentId  String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?
  answers    Json      @default("{}")

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ScheduleEntry {
  id         String  @id @default(cuid())
  groupId    String
  dayOfWeek  Int
  slot       Int
  subject    String
  subjectId  String?
  lessonType String?
  teacher    String?
  teacherId  String?
  room       String?
  parity     String?
  status     ScheduleStatus @default(NORMAL)
  note       String?
  updatedAt  DateTime       @default(now()) @updatedAt

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherRef User?    @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([groupId, dayOfWeek])
  @@index([subjectId])
  @@index([teacherId])
}

enum ScheduleStatus {
  NORMAL
  CHANGED
  MOVED
  CANCELLED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model ForumTopic {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([courseId, createdAt])
}

model ForumReply {
  id        String   @id @default(cuid())
  topicId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
}

model Certificate {
  id         String   @id @default(cuid())
  courseId   String
  studentId  String
  issuedById String
  grade      Int?
  issuedAt   DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student  User   @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy User   @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model AttendanceSession {
  id          String   @id @default(cuid())
  courseId    String
  date        DateTime
  code        String   @unique
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId, date])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  color     String   @default("#3f5a9d")
  createdAt DateTime @default(now())

  entries     ScheduleEntry[]
  courses     Course[]
  teachers    TeacherSubject[]
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([subjectId])
}

model TimeSlot {
  id        String @id @default(cuid())
  slot      Int    @unique
  startTime String
  endTime   String
}

model LessonType {
  id    String  @id @default(cuid())
  name  String  @unique
  color String  @default("#5373b8")
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  building  String?
  capacity  Int?
  equipment String?
  createdAt DateTime @default(now())
}

model RoomBooking {
  id        String   @id @default(cuid())
  roomName  String
  date      DateTime
  slot      Int
  purpose   String?
  status    String   @default("ACTIVE")
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomName, date])
  @@index([userId, date])
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  type         String
  subject      String?
  note         String?
  status       String   @default("NEW")
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model AcademicEvent {
  id          String    @id @default(cuid())
  title       String
  type        String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())

  @@index([startDate])
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model Conversation {
  id             String   @id @default(cuid())
  participantAId String
  participantBId String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  participantA User      @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User      @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
